#!/usr/bin/env bash
# cdsimage — numbered, disposable CODESYS Control for Linux SL machines.
#
# An instance is a container that behaves like a small controller: systemd,
# codesyscontrol.service, sshd, a `plc` account with passwordless sudo. Deploy
# to it the way you deploy to the real one.
#
# It has a name (cutter-a, or just 1) and a number N. It is one container
# (cds-<name>) plus one volume (cds-<name>-data), and its ports come from N so
# nothing has to be allocated by hand:
#   ssh      2200+N    (user plc, keys from $AUTH_KEYS)
#   runtime  11740+N   (IDE: device address <host>:<port>, or cdsint --port)
#   gateway  12170+N   (Edge Gateway, when the image has one)
# A numeric name is its own number. Any other name gets the lowest free number
# on first use and keeps it in $STATE, so its ports survive down/reset; so does
# its ssh host key ($CONF/hostkeys/<name>).
set -euo pipefail

# Per-host defaults (e.g. CDS_BIND=<tailscale ip>), so a later reset or a remote
# call can't silently recreate an instance on another address.
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/cdsimage
[ -f "$CONF/env" ] && . "$CONF/env"

IMAGE=${CDS_IMAGE:-cdsimage:latest}
BIND=${CDS_BIND:-127.0.0.1}          # an unauthenticated PLC: keep it off the LAN unless asked
USER_MGMT=${CDS_USER_MGMT:-off}      # benches are disposable; see README before turning this on
SEED=${CDS_SEED:-}                   # optional dir copied into a fresh instance's state
STATE=${CDS_STATE:-$CONF/instances}   # "name N" per line
AUTH_KEYS=${CDS_AUTHORIZED_KEYS:-$CONF/authorized_keys}   # who may ssh in as plc
CLAIMS=$CONF/claims                  # one file per claimed instance: "<owner> <epoch>"
CLAIM_TTL=${CDS_CLAIM_TTL:-14400}    # a claim nobody renews is free again after this (s)

usage() {
    cat <<EOF
usage: cdsimage <command> [args]

  build <packages-dir> [version]  build $IMAGE from the .package files in <packages-dir>
  up <name>...                    start an instance (creates it if needed)
  restart <name>...               reboot it and wait until the runtime accepts connections
  reset <name>...                 throw an instance away (container + volume): a fresh machine
  down <name>...                  remove an instance (container + volume); its number stays reserved
  ls                              list instances, their ports and who holds them
  claim <name|prefix-> <owner>    hold an instance for <owner>; a prefix ending in "-"
                                  takes the first free one that matches; prints its name
  release <name> <owner>          let go of it
  log <name>                      follow an instance's runtime log

<name> is a number 1..99 or a name like cutter-a.

env: CDS_IMAGE=$IMAGE CDS_BIND=$BIND CDS_USER_MGMT=$USER_MGMT CDS_SEED=${SEED:-<none>}
     CDS_AUTHORIZED_KEYS=$AUTH_KEYS
EOF
    exit 2
}

# number <name>: print the instance's number, assigning one on first use
number() {
    local name=$1 n
    [[ $name =~ ^[a-z0-9][a-z0-9_.-]*$ ]] || { echo "bad instance name '$name'" >&2; exit 2; }
    if [[ $name =~ ^[0-9]+$ ]]; then
        n=$((10#$name))
    else
        mkdir -p "$(dirname "$STATE")"; touch "$STATE"
        n=$(awk -v k="$name" '$1 == k { print $2 }' "$STATE")
        if [ -z "$n" ]; then
            n=1
            while awk -v n="$n" '$2 == n { f = 1 } END { exit !f }' "$STATE" ||
                  docker container inspect "cds-$n" >/dev/null 2>&1; do n=$((n + 1)); done
            echo "$name $n" >> "$STATE"
        fi
    fi
    (( n >= 1 && n <= 99 )) || { echo "instance number must be 1..99, got $n" >&2; exit 2; }
    echo "$n"
}

build() {
    local dir=${1:?packages dir} ver=${2:-}
    if [ -z "$ver" ]; then
        # newest "CODESYS Control for Linux SL <ver>.package" in the dir
        ver=$(ls "$dir" | sed -n 's/^CODESYS Control for Linux SL \(.*\)\.package$/\1/p' | sort -V | tail -1)
        [ -n "$ver" ] || { echo "no 'CODESYS Control for Linux SL <ver>.package' in $dir" >&2; exit 1; }
    fi
    docker build --build-context packages="$dir" --build-arg CDS_VERSION="$ver" \
        -t "cdsimage:$ver" -t cdsimage:latest "$(dirname "$(readlink -f "$0")")"
}

wait_ready() {
    local c=$1 i
    for i in $(seq 1 60); do
        docker exec "$c" ss -Hltn 'sport = :11740' 2>/dev/null | grep -q . && return 0
        sleep 1
    done
    echo "$c: runtime not listening after 60 s" >&2
    return 1
}

up() {
    local c=cds-$1 n; n=$(number "$1")
    if docker container inspect "$c" >/dev/null 2>&1; then
        docker start "$c" >/dev/null
    else
        local mounts=(-v "$c-data:/var/opt/codesys" -v "$CONF/hostkeys/$1:/etc/ssh/hostkeys")
        mkdir -p "$CONF/hostkeys/$1"
        [ -f "$AUTH_KEYS" ] && mounts+=(-v "$(readlink -f "$AUTH_KEYS")":/etc/cdsimage/authorized_keys:ro)
        [ -n "$SEED" ] && mounts+=(-v "$(readlink -f "$SEED")":/seed:ro)
        # systemd as PID 1: its own writable cgroup namespace (no host cgroup
        # tree, no --privileged) and a tmpfs /run. SYS_NICE + rtprio for the
        # runtime's SCHED_FIFO tasks.
        docker run -d --name "$c" --hostname "$c" --label cdsimage.instance="$1" \
            --restart unless-stopped \
            --cgroupns private --security-opt writable-cgroups=true \
            --tmpfs /run --tmpfs /run/lock \
            --cap-add SYS_NICE --cap-add IPC_LOCK --ulimit rtprio=99 --ulimit memlock=-1 \
            -e CDS_USER_MGMT="$USER_MGMT" \
            -p "$BIND:$((2200 + n)):22" \
            -p "$BIND:$((11740 + n)):11740" -p "$BIND:$((12170 + n)):1217" \
            "${mounts[@]}" "$IMAGE" >/dev/null
    fi
    wait_ready "$c"
    echo "$c up: ssh plc@$BIND -p $((2200 + n)), runtime $BIND:$((11740 + n)), gateway $BIND:$((12170 + n))"
}

down() {
    local c=cds-$1
    docker rm -f "$c" >/dev/null 2>&1 || true
    docker volume rm "$c-data" >/dev/null 2>&1 || true
    echo "$c down"
}

restart() {
    docker restart "cds-$1" >/dev/null
    wait_ready "cds-$1"
    echo "cds-$1 restarted"
}

ls_() {
    docker ps -a --filter label=cdsimage.instance \
        --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Ports}}'
    local f
    for f in "$CLAIMS"/*; do
        [ -f "$f" ] && holder "$(basename "$f")" >/dev/null &&
            echo "claimed: $(basename "$f") by $(holder "$(basename "$f")")"
    done
    return 0
}

# holder <name>: print who holds a live claim on it; fails if nobody does
holder() {
    local owner t
    read -r owner t 2>/dev/null < "$CLAIMS/$1" || return 1
    (( $(date +%s) - t < CLAIM_TTL )) || return 1
    echo "$owner"
}

# claim <name|prefix-> <owner>: claiming again as the same owner renews it
claim() {
    local want=$1 owner=$2 c name h
    [[ $owner =~ ^[A-Za-z0-9_.@-]+$ ]] || { echo "bad owner '$owner'" >&2; exit 2; }
    mkdir -p "$CLAIMS"
    exec 9>"$CLAIMS/.lock"; flock 9
    for c in $(docker ps --filter label=cdsimage.instance --format '{{.Names}}' | sort); do
        name=${c#cds-}
        [[ $want == *- ]] && [[ $name == "$want"* ]] || [ "$name" = "$want" ] || continue
        if h=$(holder "$name") && [ "$h" != "$owner" ]; then continue; fi
        echo "$owner $(date +%s)" > "$CLAIMS/$name"
        echo "$name"
        return 0
    done
    echo "no free running instance matches '$want'" >&2
    exit 1
}

release() {
    local h
    if h=$(holder "$1") && [ "$h" != "$2" ]; then echo "$1 is held by $h, not $2" >&2; exit 1; fi
    rm -f "$CLAIMS/$1"
    echo "$1 released"
}

cmd=${1:-}; shift || true
case $cmd in
    build)   build "$@" ;;
    ls)      ls_ ;;
    claim)   [ $# -eq 2 ] || usage; claim "$1" "$2" ;;
    release) [ $# -eq 2 ] || usage; release "$1" "$2" ;;
    log)     [ -n "${1:-}" ] || usage; docker exec "cds-$1" tail -n 50 -F /var/opt/codesys/codesyscontrol.log ;;
    up|down|restart|reset)
        [ $# -gt 0 ] || usage
        for n in "$@"; do
            case $cmd in
                reset) down "$n"; up "$n" ;;
                *)     "$cmd" "$n" ;;
            esac
        done ;;
    *) usage ;;
esac
